# Netlify headers. Works with Git, CLI and drag-and-drop deploys.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML, estilo.css and barra-fixa.js keep Netlify's default (revalidate on every
# visit, cheap thanks to ETags). They change together on each deploy, so a
# returning visitor must never get new HTML with an old stylesheet.

# Photos and icon: 7 days. Filenames have no hash, so a replaced photo can take
# up to a week to show for returning visitors; use a new filename to force it.
/img/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# Fonts never change once published.
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
